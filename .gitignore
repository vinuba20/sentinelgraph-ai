
# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# Virtual environments
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Secrets and local environment variables
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# CIC-IDS2017 dataset and generated data
# ==========================================
# Never upload raw datasets or generated datasets
data/raw/*
data/interim/*
data/processed/*

# Keep placeholder files and documentation
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/README.md

# ==========================================
# Generated machine learning artifacts
# ==========================================
*.joblib
*.pkl
*.pickle
*.model
*.h5
*.keras
*.onnx

# ==========================================
# Jupyter notebooks
# ==========================================
.ipynb_checkpoints/

# ==========================================
# IDE and editor settings
# ==========================================
.vscode/
.idea/

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Logs and temporary files
# ==========================================
*.log
*.tmp
*.temp
